# ==============================================================================
# ENVIRONMENT CONFIGURATION - MONOREPO
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simple_ai_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simple_ai_agent

# Redis (Caching & Token-Bucket Rate Limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30

# Security & Authentication (Argon2id + JWT)
SECRET_KEY=generate_a_secure_random_string_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Strategy Configuration
# Options: 'gemini' or 'ollama'
LLM_PROVIDER=gemini

# Google Gemini Settings (Used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Settings (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chat Memory & Context Management
CHAT_MEMORY_WINDOW_SIZE=10

# Search & Tool Integrations (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# API / CORS Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:4200"]
