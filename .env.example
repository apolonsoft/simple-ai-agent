# ==============================================================================
# ENVIRONMENT CONFIGURATION - MONOREPO
# ==============================================================================

# Docker Compose Profiles (Optional)
# Leave commented/empty to run only core services (PostgreSQL, Redis, Mailpit).
# Set to 'ollama' to start the local Ollama container when running docker compose:
# COMPOSE_PROFILES=ollama

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simple_ai_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simple_ai_agent

# Redis (Caching & Token-Bucket Rate Limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30

# Security & Authentication (Argon2id + JWT)
# Generate a production key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_SECRET_RANDOM_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Strategy Configuration
# Options: 'gemini' or 'ollama'
LLM_PROVIDER=gemini

# Google Gemini Settings (Used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Settings (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chat Memory & Context Management
CHAT_MEMORY_WINDOW_SIZE=10

# Search & Tool Integrations (Optional)
TAVILY_API_KEY=your_tavily_api_key_here
MCP_TAVILY_URL=http://127.0.0.1:8001/sse
MCP_PDF_URL=http://127.0.0.1:8002/sse
MCP_PDF_DIR=outputs/pdfs

# Mailpit / SMTP Email Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_RESET_URL=http://localhost:4200/reset-password

# S3 Object Storage (SeaweedFS / S3 Compatible)
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET_NAME=avatars
S3_PUBLIC_URL_PREFIX=http://localhost:8333/avatars
MAX_AVATAR_SIZE_BYTES=5242880

# API / CORS Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:4200"]
# Reverse proxy IP(s) trusted for X-Forwarded-For (never '*' on an internet-facing port)
FORWARDED_ALLOW_IPS=127.0.0.1
